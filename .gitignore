# ============================================================
# ExoScope / HBLI — Git Ignore Rules
# ============================================================

# ── Python Bytecode & Builds ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
.eggs/
*.egg

# ── Virtual Environments ──
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ── Testing, Coverage & Linters ──
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/

# ── Machine Learning & Vision Artifacts ──
runs/
wandb/
lightning_logs/
.cache/
*.pt
*.pth
*.onnx
*.engine
*.tflite
models/*.joblib
models/*.pkl
models/*.pt
models/*.onnx
models/*.json
models/checkpoints/

# ── Large Astronomical & High-Volume Data ──
*.fits
*.fit
*.fts
*.h5
*.hdf5
*.parquet
*.feather
.astropy/
.astroquery/

# ── Data Directories (Preserve structure via .gitkeep) ──
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/tabular/*
!data/tabular/.gitkeep
data/vision/*
!data/vision/.gitkeep
data/labels/*
!data/labels/.gitkeep

# ── Bulk Data Ingestion Downloads (500MB – 30GB+) ──
data/exoplanets_bulk/
data/exoplanets_*/
data/*_bulk/
data/bulk/
data/downloads/
data/test_*/

# ── Logs & Reports ──
logs/*.log
logs/*
!logs/.gitkeep
reports/*.html
reports/*.json
reports/*.png
reports/figures/

# ── Streamlit & Secrets ──
.env
.env.*
!.env.example
.streamlit/secrets.toml
.streamlit/*.local.toml

# ── IDEs & Text Editors ──
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── OS Generated Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Jupyter Notebooks ──
.ipynb_checkpoints/
*-checkpoint.ipynb
